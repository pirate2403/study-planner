{
  "name": "study-planner",
  "private": true,
  "scripts": {
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose stop postgres",
    "db:reset": "npm run db:down && npm run db:up",
    "dev:server": "cd server && npm run start:dev",
    "dev:client": "cd client && npm run dev",
    "docker:up": "docker compose up -d --build --wait",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f server postgres"
  }
}
